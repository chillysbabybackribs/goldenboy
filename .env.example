# Local provider configuration
# Copy this file to `.env` if you want local API-backed providers.

ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
GEMINI_MODEL_COMPLEX=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_LITE=gemini-2.5-flash-lite
# Optional: routing preference for Gemini provider selection
# GEMINI_ROUTER_STRATEGY=balanced
# Optional: explicit Gemini fallback order for research-sidecar JSON tasks
# GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.5-pro
